# Frontend (Next.js) environment. Copy to `main/.env.local` and fill in values.
# Never commit the real `.env.local`.

# Core
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
ACI_SERVER_URL=http://localhost:8000
# Must match the backend ENCRYPTION_KEY
ENCRYPTION_KEY=

# Admin panel
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM providers
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email (Resend)
RESEND_API_KEY=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Observability
NEXT_PUBLIC_SENTRY_URL=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Upstash (QStash / Redis / Vector)
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_URL=
UPSTASH_VECTOR_TOKEN=

# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# MCP deployment
GITHUB_TOKEN=
VEYRAX_DEPLOY_BASE_URL=

# OAuth apps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
