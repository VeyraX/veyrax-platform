# Backend (aci_server) environment. Copy to `.env` and fill in values.
# Never commit the real `.env`.

# ============================================================
# REQUIRED — the server will not work without these
# ============================================================

# 64 hex chars (32 bytes), e.g. `openssl rand -hex 32`. Encrypts stored user tokens/API keys.
ENCRYPTION_KEY=
# Local Supabase (`supabase start`): http://host.docker.internal:54321 and SERVICE_ROLE_KEY from `supabase status -o env`
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# All model calls (agent, flows, tool parameter generation, embeddings) go through https://openrouter.ai
OPENROUTER_API_KEY=
# Defaults work with docker-compose.yml
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ============================================================
# OPTIONAL — enable only the features / integrations you need
# ============================================================

# Core
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
SITE_URL=
SITE_NAME=
PORT=8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Lead enrichment ("fild") — separate Supabase project
FILD_SUPABASE_URL=
FILD_SUPABASE_SERVICE_KEY=

# Service account (internal admin user, enables /debug routes)
SERVICE_ACCOUNT_UID=
SERVICE_ACCOUNT_EMAIL=
SERVICE_ACCOUNT_SECRET=

# Redis password / Flower (docker-compose.celery.yml)
REDIS_PASSWORD=
FLOWER_USER=
FLOWER_PASSWORD=

# LLM extras: override the default OpenRouter models (see aci_server/llm.py), e.g. with cheaper or ":free" ones
OPENROUTER_AGENT_MODEL=
OPENROUTER_FAST_MODEL=
TAVILY_API_KEY=

# Observability
SENTRY_URL=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
DD_API_KEY=

# Vector stores
QDRANT_URL=
QDRANT_API_KEY=
UPSTASH_EXTERNAL_MCP_URL=
UPSTASH_EXTERNAL_MCP_TOKEN=
UPSTASH_PROVIDERS_URL=
UPSTASH_PROVIDERS_TOKEN=

# Google Cloud (Cloud Tasks / Cloud Run)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
CLOUD_TASKS_QUEUE=
CLOUD_RUN_SERVICE_URL=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# MCP deployment
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WORKFLOW_ID=
VEYRAX_DEPLOY_API_URL=

# WhatsApp bridge
WHATSAPP_API_BASE_URL=http://localhost:8080/api

# Outbound proxy
PROXY_DOMAIN=
PROXY_PORTS=
PROXY_USERNAME=
PROXY_PASSWORD=

# Deployment (docker-compose.prod.yml)
CERTBOT_EMAIL=
DOMAIN_NAME=

# OAuth apps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SENTRY_INTEGRATION_CLIENT_ID=
SENTRY_INTEGRATION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
TRELLO_API_KEY=

# Third-party API keys
IPINFO_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_KEY_YELP=
RAPID_API_APOLLO_KEY=
RAPID_API_FACEBOK_API_KEY=
RAPID_API_INSTAGRAM_API_KEY=
RAPID_API_LINKEDIN_API_KEY=
RAPID_API_SKYSCANNER_KEY=
RAPID_API_TWITTER_API_KEY=
RAPID_API_ZILLOW_KEY=
